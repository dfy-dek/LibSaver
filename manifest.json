{
  "manifest_version": 3,
  "name": "LibSaver",
  "version": "1.3",
  "description": "Любимые тайтлы при белых списках.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "system.display"
  ],

  "declarative_net_request": {
    "rule_resources": [{
      "id": "manga_headers",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ranobelib.me/*", "https://mangalib.me/*", "https://hentailib.me/*", "https://v2.shlib.life/*", "https://animelib.org/*", "https://anilib.me/*", "https://v2.animelib.org/*", "https://v5.animelib.org/*"],
      "js": ["content/SiteMenuRestorer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "html/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["html/popup.html", "html/settings.html", "html/metadata.html", "html/chapters.html", "html/covers.html", "html/prepare.html", "assets/local_data", "assets/svg/*.svg", "assets/fonts/*", "assets/gif/*"],
      "matches": ["<all_urls>"]
    }
  ]
}